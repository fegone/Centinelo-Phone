--- /dev/null
+++ b/src/cent_getopt.h
@@ -0,0 +1,106 @@
+/**
+ * @file src/cent_getopt.h  Minimal getopt() stand-in for platforms
+ *                          without <getopt.h> (MSVC)
+ *
+ * Centinelo Phone v2 F1.2 patch (core/patches/) -- see the comment at
+ * this header's only #include site (src/main.c, "#ifndef HAVE_GETOPT")
+ * for why this exists.
+ *
+ * This implements the small subset of POSIX getopt() semantics
+ * src/main.c's own option loop needs:
+ *   - single-dash short options, declared in one optstring
+ *   - ':' right after a letter in optstring means "takes a value"
+ *   - a value may be glued to the flag ("-fpath") or be the next argv[]
+ *     ("-f path")
+ *   - flags with no value may be bundled ("-46")
+ *   - unknown option, or a value-taking option missing its value,
+ *     returns '?' and advances past it (never gets stuck, never aborts
+ *     the whole parse) -- this matches glibc/BSD getopt()'s own
+ *     behavior for the same cases, so callers (src/main.c's switch)
+ *     don't need to special-case this fallback
+ *   - "--" ends option parsing
+ *
+ * Not a general getopt() replacement (no GNU long-options, no optional
+ * "::" arguments, no reordering of non-option argv[] entries around
+ * options the way GNU getopt() does by default) -- deliberately scoped
+ * to exactly what src/main.c uses. `cent_optind` is not reset between
+ * calls to `cent_getopt()`-parsing a second, independent argv[] in the
+ * same process would need it reset to 1 first; src/main.c only ever
+ * parses argv[] once per process, so this header doesn't provide a
+ * reset entry point.
+ */
+
+#ifndef CENT_GETOPT_H
+#define CENT_GETOPT_H
+
+#include <string.h>
+
+static char *cent_optarg;
+static int cent_optind = 1;
+
+static int cent_getopt(int argc, char *const argv[], const char *optstring)
+{
+	static int subopt = 1; /* position within argv[cent_optind] */
+	char *arg;
+	char *p;
+	int c;
+
+	if (cent_optind >= argc)
+		return -1;
+
+	arg = argv[cent_optind];
+
+	if (arg[0] != '-' || arg[1] == '\0')
+		return -1;
+
+	if (arg[1] == '-' && arg[2] == '\0') {
+		/* "--" explicitly ends option parsing, POSIX-style */
+		++cent_optind;
+		return -1;
+	}
+
+	c = (unsigned char)arg[subopt];
+	p = strchr(optstring, c);
+
+	if (!p || c == ':') {
+		/* unknown option -- skip it and keep going, like getopt() */
+		++cent_optind;
+		subopt = 1;
+		return '?';
+	}
+
+	if (p[1] == ':') {
+		if (arg[subopt + 1] != '\0') {
+			/* "-fpath" (value glued to the flag) */
+			cent_optarg = &arg[subopt + 1];
+		}
+		else if (cent_optind + 1 < argc) {
+			/* "-f path" (value is the next argv[]) */
+			cent_optarg = argv[++cent_optind];
+		}
+		else {
+			/* missing required value */
+			cent_optarg = NULL;
+			++cent_optind;
+			subopt = 1;
+			return '?';
+		}
+		++cent_optind;
+		subopt = 1;
+	}
+	else {
+		cent_optarg = NULL;
+		if (arg[subopt + 1] != '\0') {
+			/* more bundled flags follow, e.g. "-46" */
+			++subopt;
+		}
+		else {
+			++cent_optind;
+			subopt = 1;
+		}
+	}
+
+	return c;
+}
+
+#endif /* CENT_GETOPT_H */
